{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "web-design-system",
  "name": "theme-switcher",
  "displayName": "Theme Switcher",
  "description": "Multi-URL theme switcher with tab navigation supporting up to 3 themes with iframe previews",
  "icon": {
    "id": "view_carousel",
    "color": {
      "type": "enum",
      "value": "purple"
    }
  },
  "type": "edge",
  "version": "2.0.1",
  "mainFunction": "render",
  "functions": [
    {
      "name": "render",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "themes": {
            "type": "array",
            "title": "Themes",
            "description": "Array of themes with name and URL (minimum 1, maximum 3)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Theme Name",
                  "description": "Display name for the theme tab"
                },
                "url": {
                  "type": "string",
                  "title": "Theme URL",
                  "description": "URL to display in the iframe for this theme"
                }
              },
              "required": ["name", "url"]
            },
            "minItems": 1,
            "maxItems": 3
          },
          "height": {
            "type": "string",
            "title": "Height",
            "description": "Iframe height (e.g., '600px', '50vh')",
            "default": "600px"
          },
          "defaultTheme": {
            "type": "string",
            "title": "Default Theme",
            "description": "Name of the theme to display by default (must match one of the theme names)"
          },
          "cssClass": {
            "type": "string",
            "title": "CSS Class",
            "description": "Additional CSS classes to apply to the component container"
          }
        },
        "required": ["themes"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "single-theme": {
      "functionData": {
        "render": {
          "inputData": {
            "type": "inline",
            "value": {
              "themes": [
                {
                  "name": "Default",
                  "url": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=&args=&id=components-button--primary&viewMode=story"
                }
              ],
              "height": "400px"
            }
          }
        }
      }
    },
    "two-themes": {
      "functionData": {
        "render": {
          "inputData": {
            "type": "inline",
            "value": {
              "themes": [
                {
                  "name": "Light Theme",
                  "url": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=theme:light&args=&id=components-button--primary&viewMode=story"
                },
                {
                  "name": "Dark Theme",
                  "url": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=theme:dark&args=&id=components-button--primary&viewMode=story"
                }
              ],
              "height": "500px",
              "defaultTheme": "Light Theme"
            }
          }
        }
      }
    },
    "three-themes": {
      "functionData": {
        "render": {
          "inputData": {
            "type": "inline",
            "value": {
              "themes": [
                {
                  "name": "Light",
                  "url": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=theme:light&args=&id=components-card--default&viewMode=story"
                },
                {
                  "name": "Dark",
                  "url": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=theme:dark&args=&id=components-card--default&viewMode=story"
                },
                {
                  "name": "High Contrast",
                  "url": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=theme:contrast&args=&id=components-card--default&viewMode=story"
                }
              ],
              "height": "600px",
              "defaultTheme": "Light"
            }
          }
        }
      }
    }
  }
}
