{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "web-design-system",
  "name": "tab",
  "displayName": "Tab",
  "description": "Renders an editable tab marker. Insert multiple Tab components to generate accessible sticky tab navigation.",
  "icon": {
    "id": "tab",
    "color": {
      "type": "enum",
      "value": "blue"
    }
  },
  "type": "edge",
  "version": "1.1.0",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Tab Title",
            "description": "Display title for the tab navigation button",
            "default": "Tab"
          },
          "anchor": {
            "type": "string",
            "title": "Anchor ID",
            "description": "Optional anchor ID for URL hash navigation. If blank, defaults to title in lowercase separated by hyphens.",
            "default": ""
          }
        },
        "required": ["title"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "basic": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "title": "Overview",
              "anchor": ""
            }
          }
        }
      }
    }
  }
}
