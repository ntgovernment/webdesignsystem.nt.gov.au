{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "web-design-system",
  "name": "mini-page-card",
  "displayName": "Mini Page Card",
  "description": "Compact grid layout displaying Card assets with icon and title",
  "icon": {
    "id": "layers",
    "color": {
      "type": "enum",
      "value": "orange"
    }
  },
  "type": "edge",
  "version": "1.0.1",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string",
            "title": "Grid Title",
            "description": "Optional heading for the card grid, rendered as H2"
          },
          "Description": {
            "type": "string",
            "title": "Grid Description",
            "description": "Optional description displayed below the grid title"
          },
          "Cards": {
            "type": "array",
            "title": "Cards",
            "description": "Collection of cards to display in the grid. Each card includes a link, title, and icon.",
            "items": {
              "type": "object",
              "properties": {
                "PageAsset": {
                  "type": "SquizLink",
                  "title": "Page asset"
                },
                "CardTitle": {
                  "type": "string",
                  "title": "Card title"
                },
                "IconCode": {
                  "type": "string",
                  "title": "FontAwesome class name",
                  "description": "Class string for the icon (example: fa-solid fa-circle-info)"
                }
              },
              "required": ["PageAsset", "CardTitle"]
            },
            "minItems": 1
          }
        },
        "required": []
      },
      "output": {
        "responseType": "html"
      }
    },
    {
      "name": "render",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string",
            "title": "Grid Title",
            "description": "Optional heading for the card grid, rendered as H2"
          },
          "Description": {
            "type": "string",
            "title": "Grid Description",
            "description": "Optional description displayed below the grid title"
          },
          "Cards": {
            "type": "array",
            "title": "Cards",
            "description": "Collection of cards to display in the grid. Each card includes a link, title, and icon.",
            "items": {
              "type": "object",
              "properties": {
                "PageAsset": {
                  "type": "SquizLink",
                  "title": "Page asset"
                },
                "CardTitle": {
                  "type": "string",
                  "title": "Card title"
                },
                "IconCode": {
                  "type": "string",
                  "title": "FontAwesome class name",
                  "description": "Class string for the icon (example: fa-solid fa-circle-info)"
                }
              },
              "required": ["PageAsset", "CardTitle"]
            },
            "minItems": 1
          }
        },
        "required": ["Cards"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "basic": {
      "functionData": {
        "render": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "Title": "Explore the design system",
              "Description": "Quick links to the system resources.",
              "Cards": [
                {
                  "PageAsset": {
                    "url": "/about",
                    "text": "About",
                    "target": "_self"
                  },
                  "CardTitle": "About",
                  "IconCode": "fa-light fa-circle-info"
                },
                {
                  "PageAsset": {
                    "url": "/foundations",
                    "text": "Foundations",
                    "target": "_self"
                  },
                  "CardTitle": "Foundations",
                  "IconCode": "fa-light fa-layer-group"
                },
                {
                  "PageAsset": {
                    "url": "/components",
                    "text": "Components",
                    "target": "_self"
                  },
                  "CardTitle": "Components",
                  "IconCode": "fa-light fa-cubes"
                },
                {
                  "PageAsset": {
                    "url": "/storybook",
                    "text": "Storybook",
                    "target": "_self"
                  },
                  "CardTitle": "Storybook",
                  "IconCode": "fa-light fa-book"
                },
                {
                  "PageAsset": {
                    "url": "/figma",
                    "text": "Figma UI Kit",
                    "target": "_self"
                  },
                  "CardTitle": "Figma UI Kit",
                  "IconCode": "fa-light fa-pen-nib"
                },
                {
                  "PageAsset": {
                    "url": "https://github.com/ntgovernment/web-design-system",
                    "text": "Github",
                    "target": "_blank"
                  },
                  "CardTitle": "Github",
                  "IconCode": "fa-brands fa-github"
                }
              ]
            }
          }
        }
      }
    }
  }
}
