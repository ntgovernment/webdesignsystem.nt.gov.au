{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "web-design-system",
  "name": "card",
  "displayName": "Card",
  "description": "Responsive cards with display and mini variants, editable directly in Visual Page Builder.",
  "icon": {
    "id": "web_stories",
    "color": {
      "type": "enum",
      "value": "orange"
    }
  },
  "type": "edge",
  "version": "1.0.14",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "showImage": {
            "type": "boolean",
            "title": "Image",
            "description": "Show the image from each destination asset's metadata.",
            "default": true,
            "ui:metadata": {
              "quickOption": true
            }
          },
          "showIcon": {
            "type": "boolean",
            "title": "Icon",
            "description": "Show the icon from each destination asset's metadata.",
            "default": false,
            "ui:metadata": {
              "quickOption": true
            }
          },
          "cardsPerRow": {
            "type": "string",
            "title": "Cards per row",
            "description": "Choose the maximum number of cards per row. The layout uses fewer cards when space is limited.",
            "enum": ["Automatic", "2", "3", "4"],
            "default": "Automatic",
            "ui:metadata": {
              "quickOption": true
            }
          },
          "Content": {
            "type": "FormattedText",
            "title": "Content",
            "ui:metadata": {
              "inlineEditable": true
            }
          },
          "Cards": {
            "type": "array",
            "title": "Cards",
            "description": "Add, reorder, or remove cards. Media is populated from the selected destination asset's metadata.",
            "items": {
              "type": "object",
              "properties": {
                "PageAsset": {
                  "type": "SquizLink",
                  "title": "Destination",
                  "ui:metadata": {
                    "inlineEditable": true
                  }
                }
              },
              "required": []
            }
          }
        },
        "required": []
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "image-cards": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "file",
            "path": "display-cards.data.json"
          }
        }
      }
    },
    "icon-cards": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "file",
            "path": "mini-cards.data.json"
          }
        }
      }
    },
    "image-icon-cards": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "file",
            "path": "image-icon-cards.data.json"
          }
        }
      }
    },
    "resolved-asset-cards": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "file",
            "path": "resolved-asset-cards.data.json"
          }
        }
      }
    },
    "text-only-cards": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "file",
            "path": "text-only-cards.data.json"
          }
        }
      }
    }
  }
}
