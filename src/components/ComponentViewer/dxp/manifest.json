{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "web-design-system",
  "name": "component-viewer",
  "displayName": "Component Viewer",
  "description": "Interactive component viewer with Storybook iframe integration, code display, and zoom controls",
  "icon": {
    "id": "preview",
    "color": {
      "type": "enum",
      "value": "blue"
    }
  },
  "type": "edge",
  "version": "1.2.6",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "Introduction": {
            "type": "FormattedText",
            "format": "multi-line",
            "title": "Introduction",
            "description": "Optional introduction text displayed above the component preview. Supports rich formatting (paragraphs, lists, links, emphasis)."
          },
          "storybookUrl": {
            "type": "string",
            "title": "Storybook URL",
            "description": "Full Storybook iframe URL including story ID and parameters (e.g., 'https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=&args=&id=components-button--primary&viewMode=story')"
          },
          "codeExample": {
            "type": "FormattedText",
            "format": "multi-line",
            "title": "Code Example",
            "description": "HTML code example to display in code panel"
          },
          "height": {
            "type": "string",
            "title": "Height",
            "description": "Iframe height (e.g., '400px', '50vh')",
            "default": "400px"
          },
          "showCodeByDefault": {
            "type": "boolean",
            "title": "Show Code by Default",
            "description": "Whether to show code panel on initial load",
            "default": false
          },
          "cssClass": {
            "type": "string",
            "title": "CSS Class",
            "description": "Additional CSS classes to apply to the component container"
          }
        },
        "required": ["storybookUrl"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "basic": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "storybookUrl": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=&args=&id=components-button--primary&viewMode=story",
              "height": "200px"
            }
          }
        }
      }
    },
    "with-code": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "storybookUrl": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=&args=&id=components-header--default&viewMode=story",
              "Introduction": "<p>This is an <strong>interactive preview</strong> of the Header component. You can <em>zoom in and out</em> using the controls, and view the underlying HTML code by clicking the 'See code' button below.</p>\n<ul>\n<li>Zoom controls for detailed inspection</li>\n<li>Code panel with syntax highlighting</li>\n<li>Open in new tab for full testing</li>\n</ul>",
              "height": "300px",
              "showCodeByDefault": true,
              "codeExample": "<header class=\"nt-header\">\n  <h1>Example Header</h1>\n</header>"
            }
          }
        }
      }
    },
    "custom-zoom": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "storybookUrl": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=&args=&id=components-card--default&viewMode=story",
              "height": "400px"
            }
          }
        }
      }
    },
    "minimal": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "storybookUrl": "https://ntgovernment.github.io/ntg-design-system/iframe.html?globals=&args=&id=components-button--secondary&viewMode=story",
              "height": "150px"
            }
          }
        }
      }
    }
  }
}
