{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "web-design-system",
  "name": "color-swatch",
  "displayName": "Color Swatch",
  "description": "Displays a color swatch card with color sample, label, and hex code",
  "icon": {
    "id": "palette",
    "color": {
      "type": "enum",
      "value": "orange"
    }
  },
  "type": "edge",
  "version": "2.1.1",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "Introduction": {
            "type": "FormattedText",
            "title": "Introduction",
            "description": "Optional formatted introduction displayed above the swatch grid",
            "ui:metadata": {
              "inlineEditable": true
            }
          },
          "ColorValues": {
            "type": "array",
            "title": "Color Swatches",
            "description": "Collection of color swatches to display. Each color value represents one swatch card.",
            "items": {
              "type": "object",
              "properties": {
                "Name": {
                  "type": "string",
                  "title": "Name",
                  "description": "Display name for the color (for example, 'Blue 03')",
                  "ui:metadata": {
                    "inlineEditable": true
                  }
                },
                "Hex": {
                  "type": "string",
                  "title": "Hex",
                  "description": "Hex value used for the swatch color (for example, '#1F1F5F')",
                  "ui:metadata": {
                    "inlineEditable": true
                  }
                }
              },
              "required": ["Name", "Hex"]
            },
            "minItems": 1
          }
        },
        "required": []
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "basic": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "Introduction": "The extended color palette provides a <strong>range</strong> of shades for each base color.",
              "ColorValues": [
                {
                  "Name": "Blue 03",
                  "Hex": "#1F1F5F"
                },
                {
                  "Name": "Orange 03",
                  "Hex": "#E35205"
                },
                {
                  "Name": "Ochre 02",
                  "Hex": "#C33826"
                },
                {
                  "Name": "Coral 03",
                  "Hex": "#C25062"
                }
              ]
            }
          }
        }
      }
    }
  }
}
