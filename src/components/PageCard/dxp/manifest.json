{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "web-design-system",
  "name": "page-card",
  "displayName": "Page Card Grid",
  "description": "Responsive grid layout displaying Card assets with Image and Title",
  "icon": {
    "id": "layers",
    "color": {
      "type": "enum",
      "value": "orange"
    }
  },
  "type": "edge",
  "version": "1.0.7",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string",
            "title": "Grid Title",
            "description": "Optional heading for the card grid, rendered as H2"
          },
          "PageArray": {
            "type": "array",
            "title": "Page Array",
            "description": "Array of card items. Each item supports a page link, an image link, and a display title.",
            "items": {
              "type": "object",
              "properties": {
                "PageAsset": {
                  "type": "SquizLink",
                  "title": "Page asset"
                },
                "CardImage": {
                  "type": "SquizImage",
                  "title": "Card image"
                },
                "CardTitle": {
                  "type": "string",
                  "title": "Card title"
                }
              },
              "required": ["PageAsset", "CardTitle"]
            },
            "minItems": 1
          }
        },
        "required": []
      },
      "output": {
        "responseType": "html"
      }
    },
    {
      "name": "render",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string",
            "title": "Grid Title",
            "description": "Optional heading for the card grid, rendered as H2"
          },
          "PageArray": {
            "type": "array",
            "title": "Page Array",
            "description": "Array of card items. Each item supports a page link, an image link, and a display title.",
            "items": {
              "type": "object",
              "properties": {
                "PageAsset": {
                  "type": "SquizLink",
                  "title": "Page asset"
                },
                "CardImage": {
                  "type": "SquizImage",
                  "title": "Card image"
                },
                "CardTitle": {
                  "type": "string",
                  "title": "Card title"
                }
              },
              "required": ["PageAsset", "CardTitle"]
            },
            "minItems": 1
          }
        },
        "required": ["PageArray"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "basic": {
      "functionData": {
        "render": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "Title": "Key Services",
              "PageArray": [
                {
                  "PageAsset": {
                    "url": "/business/licensing",
                    "text": "Business Licensing",
                    "target": "_self"
                  },
                  "CardImage": {
                    "name": "Business Licensing image",
                    "alt": "Business Licensing",
                    "caption": "Business Licensing",
                    "imageVariations": {
                      "original": {
                        "url": "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=640&h=360&fit=crop",
                        "width": 640,
                        "height": 360,
                        "byteSize": 0,
                        "mimeType": "image/jpeg",
                        "aspectRatio": "16:9",
                        "sha1Hash": "0000000000000000000000000000000000000000"
                      }
                    }
                  },
                  "CardTitle": "Business Licensing"
                },
                {
                  "PageAsset": {
                    "url": "/grants/community",
                    "text": "Community Grants",
                    "target": "_self"
                  },
                  "CardImage": {
                    "name": "Community Grants image",
                    "alt": "Community Grants",
                    "caption": "Community Grants",
                    "imageVariations": {
                      "original": {
                        "url": "https://images.unsplash.com/photo-1552664730-d307ca884978?w=640&h=360&fit=crop",
                        "width": 640,
                        "height": 360,
                        "byteSize": 0,
                        "mimeType": "image/jpeg",
                        "aspectRatio": "16:9",
                        "sha1Hash": "0000000000000000000000000000000000000000"
                      }
                    }
                  },
                  "CardTitle": "Community Grants"
                },
                {
                  "PageAsset": {
                    "url": "/health",
                    "text": "Health Services",
