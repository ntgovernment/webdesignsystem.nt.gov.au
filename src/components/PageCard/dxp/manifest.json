                  },
                  "CardImage": {
                    "name": "Health Services image",
                    "alt": "Health Services",
                    "caption": "Health Services",
                    "imageVariations": {
                      "original": {
                        "url": "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=640&h=360&fit=crop",
                        "width": 640,
                        "height": 360,
                        "byteSize": 0,
                        "mimeType": "image/jpeg",
                        "aspectRatio": "16:9",
                        "sha1Hash": "0000000000000000000000000000000000000000"
                      }
                    }
