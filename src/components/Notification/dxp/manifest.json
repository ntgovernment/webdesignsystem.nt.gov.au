{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "namespace": "web-design-system",
  "name": "notification",
  "displayName": "Notification",
  "description": "Status-specific notification with accent bar and icon",
  "icon": {
    "id": "notification_important",
    "color": {
      "type": "enum",
      "value": "blue"
    }
  },
  "type": "edge",
  "version": "1.0.2",
  "mainFunction": "main",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Notification heading",
            "default": "Information alert"
          },
          "message": {
            "type": "FormattedText",
            "title": "Message",
            "description": "Notification message content",
            "default": "Your application has been submitted for review.",
            "ui:metadata": {
              "inlineEditable": true
            }
          },
          "variant": {
            "type": "string",
            "title": "Variant",
            "description": "Status type",
            "default": "info",
            "enum": ["info", "success", "warning", "danger"]
          },
          "cssClass": {
            "type": "string",
            "title": "CSS Class",
            "description": "Additional CSS classes to apply"
          }
        },
        "required": []
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "basic": {
      "functionData": {
        "main": {
          "wrapper": {
            "path": "preview.html"
          },
          "inputData": {
            "type": "inline",
            "value": {
              "variant": "info",
              "title": "Information alert",
              "message": "Your application has been submitted for review."
            }
          }
        }
      }
    }
  }
}
